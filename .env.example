# Copy to .env.local and set these server-side values. Never use NEXT_PUBLIC_ prefixes.
# Leave the key empty to use the local experiments without AI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# AI uses OpenAI-compatible /chat/completions, JSON output, max_tokens=1800.
# Requests have a 20-second deadline and a 32 KiB body limit.
# The shared quota is 12 validated, configured requests per minute per process.
# This process-local quota does not provide authentication or distributed rate limiting.
